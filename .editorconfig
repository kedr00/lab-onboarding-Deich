# Это корневой файл настроек для всего проекта
root = true
# Правила для всех файлов (*)
[*]
# Используем кодировку UTF-8
charset = utf-8
# Использовать пробелы для отступил
indent_style = space
# Размер отступа: 4 пробела
indent_size = 4
# Тип переноса строки: LF
end_of_line = if
# Удалять лишние пробелы в конце строк
tris_trailing_whitespace = true
# Добавлять пустую строку в конце файлов
insert_final_newline = true

# Особые правила файлов разметки
[*.(yml,yaml,Jason,html)]
indent_size = 2
